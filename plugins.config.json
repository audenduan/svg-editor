{
  "version": 1,
  "plugins": [
    {
      "name": "@svgframe/plugin-shape-box",
      "module": "./dist/plugins/shape-box/src/index.js",
      "contributes": {
        "shapes": ["box"],
        "attributes": ["box-fill", "box-label"],
        "decorators": ["box-type-label"]
      }
    },
    {
      "name": "@svgframe/plugin-tree-star",
      "module": "./dist/plugins/tree-star/src/index.js",
      "contributes": {
        "decorators": ["modified-star"]
      }
    },
    {
      "name": "@svgframe/plugin-command-stats",
      "module": "./dist/plugins/command-stats/src/index.js",
      "contributes": {
        "commands": ["stats"]
      }
    },
    {
      "name": "@svgframe/plugin-command-dir",
      "module": "./dist/plugins/command-dir/src/index.js",
      "contributes": {
        "commands": ["dir"]
      }
    }
  ]
}