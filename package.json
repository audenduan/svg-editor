{
  "name": "svg-editor-cli",
  "version": "0.2.0",
  "private": true,
  "description": "PJ1 - a command-line SVG editor in TypeScript (Phase 1 CLI + Phase 2 plugin architecture)",
  "license": "MIT",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsc -p tsconfig.json && node dist/src/main.js",
    "start": "node dist/src/main.js",
    "test": "npm run build --silent && node scripts/check-dependencies.mjs && node scripts/check-layers.mjs && node --test \"dist/tests/*.test.js\" \"dist/plugins/*/tests/*.test.js\"",
    "test:vscode": "node node_modules/typescript/bin/tsc -p vscode-svg/tsconfig.json && node --test \"vscode-svg/dist/tests/*.test.js\"",
    "metrics": "node scripts/metrics.mjs",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "start:config": "node dist/src/main.js --config config/plugins.json",
    "start:code": "node dist/src/main-code.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
